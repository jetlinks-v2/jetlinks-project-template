{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "jetlinks-web-core/src/*"
      ],
      "@jetlinks-web-core/*": [
        "jetlinks-web-core/src/*"
      ],
      "@authentication-manager-ui/*": [
        "modules/authentication-manager-ui/*"
      ],
      "@device-manager-ui/*": [
        "modules/device-manager-ui/*"
      ],
      "@saas-runtime-ui/*": [
        "modules/saas-runtime-ui/*"
      ],
      "@rule-engine-manager-ui/*": [
        "modules/rule-engine-manager-ui/*"
      ],
      "@edge-master-ui/*": [
        "modules/edge-master-ui/*"
      ]
    },
    "types": [
      "node",
      "ant-design-vue/typings/global",
      "vite/client"
    ]
  },
  "include": [
    "jetlinks-web-core/src/**/*.ts",
    "jetlinks-web-core/src/**/*.d.ts",
    "jetlinks-web-core/src/**/*.tsx",
    "jetlinks-web-core/src/**/*.vue",
    "modules/**/*.ts",
    "modules/**/*.d.ts",
    "modules/**/*.tsx",
    "modules/**/*.vue"
  ]
}
