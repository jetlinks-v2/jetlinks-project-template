# 部署基础路径及后端网关；开发时也可使用 pnpm dev:proxy 指定后端。
VITE_PUBLIC_PATH=/
VITE_APP_BASE_API=/api
VITE_APP_DEV_PROXY_URL=http://localhost:8844
VITE_PORT=9100

# 平台统一认证头；这些值是字段名，不是访问令牌。
VITE_TOKEN_KEY=X-Access-Token
VITE_TOKEN_KEY_URL=:X_Access_Token
VITE_PERSONAL_TOKEN_KEY=X-Personal-Token
VITE_PERSONAL_TOKEN_URL_KEY=:X_Personal_Token
VITE_PERSONAL_TOKEN_AI_KEY=personal_token
VITE_TOKEN_REFRESH=true

# 默认接入 SaaS 项目运行时。独立部署时将 VITE_APP_ENVIRONMENT 设为空。
VITE_MICRO_APP=false
VITE_APP_NAME=my-project
VITE_APP_ENVIRONMENT=saas
VITE_APP_RUNTIME_SCOPE=project
VITE_APP_PROJECT_CODE=my-project
